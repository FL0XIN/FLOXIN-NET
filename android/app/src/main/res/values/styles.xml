<resources>
    <style name="Theme.Floxin" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#00D9FF</item>
        <item name="android:navigationBarColor">#0A0E1A</item>
        <item name="android:statusBarColor">#0A0E1A</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.Floxin.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/floxin_dark_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_floxin_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Floxin</item>
    </style>
</resources>
