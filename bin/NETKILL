#!/usr/bin/env bash
# NETKILL — Emergency: stops everything and restores internet
echo "═══════════════════════════════════════"
echo "  🆘 NETKILL MODE"
echo "═══════════════════════════════════════"
echo ""

echo "[1/4] Stopping DNS..."
pkill -9 -f "floxin_dns.py" 2>/dev/null
echo "  ✓"

echo "[2/4] Stopping emulator..."
pkill -9 -f "throttle_proxy.py" 2>/dev/null
echo "  ✓"

echo "[3/4] Clearing proxies..."
unset http_proxy https_proxy
echo "  ✓"

echo "[4/4] Testing connectivity..."
sleep 2
R=$(timeout 5 curl -s -o /dev/null -w "%{http_code}" --max-time 4 "https://1.1.1.1" 2>/dev/null)
if echo "$R" | grep -qE "200|301|302|400|403"; then
    echo "  ✓ Internet is working"
else
    echo "  ⚠ Internet still down — turn off VPN manually from your phone"
    echo ""
    echo "  Steps:"
    echo "    1. Open Psiphon / WARP"
    echo "    2. Press Stop"
    echo "    3. Wait 10 seconds"
    echo "    4. If still down: Airplane Mode ON/OFF"
fi

echo ""
echo "═══════════════════════════════════════"
echo "  ✅ Done"
echo "═══════════════════════════════════════"
