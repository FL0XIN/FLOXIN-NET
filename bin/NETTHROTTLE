#!/usr/bin/env bash
# NETTHROTTLE — محاكي throttle محلي

PROXY_PORT=7777
PROXY_PID_FILE="$HOME/dnsmasq/.sim.pid"
PROXY_LOG="$HOME/dnsmasq/sim.log"

# ═══ تشغيل proxy يحد السرعة ═══
cmd_start() {
    echo "═══ تشغيل محاكي Throttle ═══"

    if pgrep -f "throttle_proxy.py" > /dev/null; then
        echo "  ⚠️ شغال بالفعل"
        return
    fi

    # نسوي ملف الـ proxy
    cat > "$HOME/dnsmasq/throttle_proxy.py" << 'PYEOF'
import socket
import threading
import time
import sys

LISTEN_PORT = 7777
RATE_BPS = 50 * 1024  # 50 KB/s
CHUNK = 1024

def forward(src, dst):
    """ينقل البيانات بـ rate محدود."""
    interval = CHUNK / RATE_BPS
    try:
        while True:
            data = src.recv(CHUNK)
            if not data:
                break
            dst.sendall(data)
            time.sleep(interval)
    except Exception:
        pass
    finally:
        try: src.close()
        except: pass
        try: dst.close()
        except: pass

def handle(client):
    try:
        request = client.recv(4096)
        if not request:
            client.close()
            return

        # CONNECT method (HTTPS)
        if request.startswith(b"CONNECT "):
            line = request.split(b"\r\n")[0].decode()
            host_port = line.split(" ")[1]
            host, port = host_port.split(":")
            port = int(port)

            upstream = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            upstream.connect((host, port))
            client.sendall(b"HTTP/1.1 200 Connection Established\r\n\r\n")

            # ابدأ النقل ثنائي الاتجاه بـ rate محدود
            t1 = threading.Thread(target=forward, args=(client, upstream))
            t2 = threading.Thread(target=forward, args=(upstream, client))
            t1.start()
            t2.start()
            t1.join()
            t2.join()
        else:
            # HTTP عادي
            line = request.split(b"\r\n")[0].decode()
            url = line.split(" ")[1]
            if url.startswith("http://"):
                url = url[7:]
            host_path = url.split("/", 1)
            host = host_path[0].split(":")[0]
            path = "/" + (host_path[1] if len(host_path) > 1 else "")

            upstream = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            upstream.connect((host, 80))
            upstream.sendall(request)

            while True:
                data = upstream.recv(CHUNK)
                if not data: break
                client.sendall(data)
                time.sleep(CHUNK / RATE_BPS)

            client.close()
            upstream.close()
    except Exception as e:
        try: client.close()
        except: pass

def main():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind(("127.0.0.1", LISTEN_PORT))
    s.listen(20)
    print(f"[sim] listening on 127.0.0.1:{LISTEN_PORT} @ {RATE_BPS/1024:.0f} KB/s")
    while True:
        client, addr = s.accept()
        threading.Thread(target=handle, args=(client,), daemon=True).start()

if __name__ == "__main__":
    main()
PYEOF

    nohup python3 "$HOME/dnsmasq/throttle_proxy.py" > "$PROXY_LOG" 2>&1 &
    echo $! > "$PROXY_PID_FILE"
    disown
    sleep 2

    if pgrep -f "throttle_proxy.py" > /dev/null; then
        echo "  ✓ Proxy شغال على 127.0.0.1:$PROXY_PORT"
        echo "  ✓ الحد: 50 KB/s"
    else
        echo "  ✗ فشل"
        tail -5 "$PROXY_LOG"
    fi
}

# ═══ Stop ═══
cmd_stop() {
    echo "═══ إيقاف المحاكي ═══"
    pkill -9 -f "throttle_proxy.py" 2>/dev/null
    rm -f "$PROXY_PID_FILE"
    echo "  ✓"
}

# ═══ Test ═══
cmd_test() {
    echo "═══ اختبار تحت Throttle ═══"
    echo ""

    if ! pgrep -f "throttle_proxy.py" > /dev/null; then
        echo "  ⚠️ شغّل: NETTHROTTLE start"
        return
    fi

    echo "🔴 اختبار 1: بدون proxy (سرعة حقيقية)"
    SPEED1=$(curl -o /dev/null -s -w "%{speed_download}" --max-time 15 "https://speed.cloudflare.com/__down?bytes=500000" 2>/dev/null)
    python3 -c "print(f'    {${SPEED1:-0}/1024:.1f} KB/s')"
    echo ""

    echo "🟡 اختبار 2: عبر Proxy (محاكي throttle)"
    SPEED2=$(curl -x "http://127.0.0.1:$PROXY_PORT" -o /dev/null -s -w "%{speed_download}" --max-time 25 "https://speed.cloudflare.com/__down?bytes=500000" 2>/dev/null)
    python3 -c "print(f'    {${SPEED2:-0}/1024:.1f} KB/s')"
    echo ""

    echo "🟢 اختبار 3: DNS تحت throttle"
    if pgrep -f "floxin_dns.py" > /dev/null; then
        TIME=$( { /usr/bin/time -f "%e" dig @127.0.0.1 -p 5353 google.com +short > /dev/null; } 2>&1 )
        echo "    DNS محلي: ${TIME}s"
    fi
    echo ""

    echo "═══════════════════════════════════════"
    echo "  📊 النتيجة"
    echo "═══════════════════════════════════════"
    python3 << PYEOF
s1 = ${SPEED1:-0}
s2 = ${SPEED2:-0}
print(f"  سرعة حقيقية: {s1/1024:.1f} KB/s")
print(f"  سرعة throttle: {s2/1024:.1f} KB/s")
if s1 > 0 and s2 > 0:
    ratio = s1 / s2
    print(f"  الفرق: {ratio:.1f}x")
PYEOF
}

# ═══ Help ═══
cmd_help() {
    cat << EOF
NETTHROTTLE — محاكي Throttle محلي

  NETTHROTTLE start   → تشغيل proxy يحاكي Throttle (50 KB/s)
  NETTHROTTLE stop    → إيقاف
  NETTHROTTLE test    → اختبار تحت Throttle
  NETTHROTTLE help    → المساعدة

كيف تستخدمه:
  1. NETTHROTTLE start
  2. export https_proxy=http://127.0.0.1:7777
  3. شغّل أي أداة واختبرها
  4. NETTHROTTLE test
  5. NETTHROTTLE stop

⚠️ المحاكي يشتغل على level HTTP فقط
   (مش بيحاكي throttle packets مثل WE)
EOF
}

CMD="${1:-help}"
case "$CMD" in
    start) cmd_start ;;
    stop)  cmd_stop ;;
    test)  cmd_test ;;
    help|*) cmd_help ;;
esac
