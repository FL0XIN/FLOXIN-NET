#!/usr/bin/env bash
CG='\033[32m'; CR='\033[31m'; CY='\033[33m'; CC='\033[36m'; CZ='\033[0m'
P=0; F=0; W=0
ok()   { echo -e "  ${CG}[OK]${CZ}   $1"; P=$((P+1)); }
bad()  { echo -e "  ${CR}[FAIL]${CZ} $1"; F=$((F+1)); }
warn() { echo -e "  ${CY}[WARN]${CZ} $1"; W=$((W+1)); }
sec()  { echo -e "\n${CC}--- $1 ---${CZ}"; }
echo -e "${CC}=========================================${CZ}"
echo -e "${CC}  TESTALL - Full System Check${CZ}"
echo -e "${CC}  $(date '+%Y-%m-%d %H:%M')${CZ}"
echo -e "${CC}=========================================${CZ}"
sec "Scripts"
for s in FLOXIN DNSF CHECK DNSWITCH WEHACK SAFE_MODE THROTTLE_SIM TESTALL SOUSG NETSTATE PANIC; do
    [ -x "$HOME/bin/$s" ] && ok "$s" || warn "$s missing"
done
sec "DNS Server"
pgrep -f floxin_dns.py > /dev/null && ok "running (PID: $(pgrep -f floxin_dns.py | head -1))" || bad "stopped"
sec "DNS Query"
if pgrep -f floxin_dns.py > /dev/null; then
    R=$(timeout 3 dig @127.0.0.1 -p 5353 google.com +short +timeout=2 2>/dev/null | grep -v ";" | head -1)
    [ -n "$R" ] && ok "google -> $R" || bad "no response"
fi
sec "Blocking"
B=0
for d in doubleclick.net googleadservices.com googlesyndication.com adservice.google.com scorecardresearch.com; do
    R=$(timeout 2 dig @127.0.0.1 -p 5353 "$d" +short +timeout=1 2>/dev/null | grep -v ";" | head -1)
    [ "$R" = "0.0.0.0" ] && B=$((B+1))
done
[ "$B" -ge 4 ] && ok "active ($B/5)" || bad "not working ($B/5)"
sec "Blocklist"
BL="$HOME/dnsmasq/blocklist.txt"
if [ -f "$BL" ]; then
    CNT=$(wc -l < "$BL")
    [ "$CNT" -gt 10000 ] && ok "$CNT domains" || warn "$CNT only"
else
    bad "missing"
fi
sec "Speed"
S=$(timeout 10 curl -o /dev/null -s -w "%{speed_download}" --max-time 8 "https://speed.cloudflare.com/__down?bytes=200000" 2>/dev/null)
if [ -z "$S" ] || [ "$S" = "0" ]; then
    bad "no connection"
else
    KB=$(python3 -c "print(f'{$S/1024:.0f}')")
    python3 -c "exit(0 if $S < 100000 else 1)" 2>/dev/null && warn "throttled - ${KB} KB/s" || ok "normal - ${KB} KB/s"
fi
sec "External DNS"
CL=$(timeout 4 curl -s "https://1.1.1.1/dns-query?name=google.com&type=A" -H "accept: application/dns-json" 2>/dev/null | head -c 20)
[ -n "$CL" ] && ok "Cloudflare DoH" || warn "Cloudflare DoH"
GD=$(timeout 4 curl -s "https://dns.google/resolve?name=google.com&type=A" 2>/dev/null | head -c 20)
[ -n "$GD" ] && ok "Google DoH" || warn "Google DoH"
sec "VPN"
VPN_IFACE=$(ifconfig 2>/dev/null | grep -E "^(tun|ppp|wg)[0-9]" | head -1 | cut -d: -f1)
if [ -n "$VPN_IFACE" ]; then
    warn "VPN running ($VPN_IFACE)"
else
    ok "VPN off"
fi
sec "Files"
[ -f "$HOME/.floxin_net.sh" ] && ok ".floxin_net.sh" || warn "missing"
[ -f "$HOME/dnsmasq/floxin_dns.py" ] && ok "floxin_dns.py" || bad "missing"
[ -d "$HOME/floxin_backup" ] && ok "Backup" || warn "no backup"
echo ""
echo -e "${CC}=========================================${CZ}"
echo -e "  Summary"
echo -e "${CC}=========================================${CZ}"
echo -e "  ${CG}PASS${CZ}: $P"
echo -e "  ${CY}WARN${CZ}: $W"
echo -e "  ${CR}FAIL${CZ}: $F"
if [ $F -eq 0 ] && [ $W -eq 0 ]; then
    echo -e "  ${CG}ALL GOOD${CZ}"
elif [ $F -eq 0 ]; then
    echo -e "  ${CY}Warnings present${CZ}"
else
    echo -e "  ${CR}Issues detected${CZ}"
fi
echo -e "${CC}=========================================${CZ}"
