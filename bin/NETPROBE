#!/usr/bin/env bash
# NETPROBE — tactics against WE throttling (Egypt)

TEST_BYTES=500000   # 500 KB for testing
RESULTS="$HOME/dnsmasq/wehack_results.txt"
mkdir -p "$(dirname "$RESULTS")"

# ═══ Helper: measure URL speed ═══
speed_test() {
    local url="$1"
    local label="$2"
    printf "  %-25s " "$label"
    local speed=$(curl -o /dev/null -s -w "%{speed_download}" --max-time 15 "$url" 2>/dev/null)
    if [ -z "$speed" ] || [ "$speed" = "0" ]; then
        echo "✗ failed"
        echo "$label=0" >> "$RESULTS"
    else
        python3 -c "print(f'{$speed/1024:.1f} KB/s')"
        echo "$label=$speed" >> "$RESULTS"
    fi
}

# ═══ Tactic 1: Port Scan ═══
tactic_ports() {
    echo "═══ 1) Port Scan — which port isn't throttled? ═══"
    echo ""
    # Cloudflare edge IP — supports all these ports
    local CF="speed.cloudflare.com"
    local PORTS=(443 8443 2053 2083 2087 2096 8080 8880)
    for p in "${PORTS[@]}"; do
        speed_test "https://$CF:${p}/__down?bytes=$TEST_BYTES" "Port $p"
    done
    echo ""
}

# ═══ Tactic 2: Whitelisted Domains ═══
tactic_whitelist() {
    echo "═══ 2) Whitelisted Domains — sites allowed by WE? ═══"
    echo ""
    speed_test "https://www.speedtest.net/speedtest-servers-static.php" "speedtest.net"
    speed_test "https://www.ekb.eg/" "ekb.eg (government)"
    speed_test "https://www.google.com/favicon.ico" "Google"
    speed_test "https://www.cloudflare.com/favicon.ico" "Cloudflare"
    echo ""
}

# ═══ Tactic 3: HTTP/3 (QUIC) ═══
tactic_http3() {
    echo "═══ 3) HTTP/3 (QUIC) — UDP/443 ═══"
    echo ""
    if command -v curl >/dev/null 2>&1; then
        local version=$(curl --version | grep -o "HTTP3" | head -1)
        if [ -z "$version" ]; then
            echo "  ⚠️ curl not built with HTTP/3"
            echo "  (needs curl rebuilt with ngtcp2)"
        else
            speed_test "https://cloudflare-quic.com/" "QUIC test"
        fi
    fi
    echo ""
}

# ═══ Tactic 4: DNS Port Test ═══
tactic_dns() {
    echo "═══ 4) DNS — 53 vs 5353 vs DoH ═══"
    echo ""
    printf "  %-25s " "Port 53 (Cloudflare):"
    local t1=$( { /usr/bin/time -f "%e" nslookup google.com 1.1.1.1 >/dev/null 2>&1; } 2>&1 )
    echo "${t1}s"

    printf "  %-25s " "Port 5353 (local):"
    local t2=$( { /usr/bin/time -f "%e" nslookup google.com 127.0.0.1 >/dev/null 2>&1; } 2>&1 )
    echo "${t2}s"
    echo ""
}

# ═══ Tactic 5: IPv6 ═══
tactic_ipv6() {
    echo "═══ 5) IPv6 — might not be throttled ═══"
    echo ""
    local ipv6=$(ip -6 addr show 2>/dev/null | grep "inet6" | grep -v "::1" | head -1)
    if [ -z "$ipv6" ]; then
        echo "  ⚠️ No IPv6 on device"
    else
        echo "  ✓ IPv6 present: $ipv6"
        printf "  %-25s " "IPv6 test:"
        speed_test "https://ipv6.google.com/favicon.ico" "IPv6 Google"
    fi
    echo ""
}

# ═══ Tactic 6: Cloudflare WARP ═══
tactic_warp() {
    echo "═══ 6) Cloudflare WARP — free and fast ═══"
    echo ""
    echo "  🎯 Link: https://1.1.1.1/"
    echo "  📱 App: 1.1.1.1 (Cloudflare)"
    echo "  ✅ 100% free, does not require an API key"
    echo "  ✅ bypasses throttling in Egypt for many users"
    echo ""
    echo "  Quick commands:"
    echo "    pkg install wireguard-tools"
    echo "    (afterwards we'll do WARP setup manually)"
    echo ""
}

# ═══ Run all ═══
cmd_all() {
    > "$RESULTS"
    echo ""
    echo "═══════════════════════════════════════"
    echo "  NETPROBE — tactics against WE"
    echo "  $(date '+%Y-%m-%d %H:%M')"
    echo "═══════════════════════════════════════"
    echo ""

    tactic_ports
    tactic_whitelist
    tactic_http3
    tactic_dns
    tactic_ipv6
    tactic_warp

    echo "═══════════════════════════════════════"
    echo "  📊 Analysis"
    echo "═══════════════════════════════════════"
    echo ""

    # Analyze the results
    python3 << PYEOF
import re
results = {}
try:
    with open("$RESULTS") as f:
        for line in f:
            if "=" in line:
                k, v = line.strip().split("=", 1)
                try:
                    results[k] = float(v)
                except:
                    pass
except:
    pass

if results:
    best = max(results.items(), key=lambda x: x[1])
    print(f"  🏆 fastest: {best[0]} ({best[1]/1024:.1f} KB/s)")
    print()
    print("  📈 Ranking:")
    for k, v in sorted(results.items(), key=lambda x: -x[1])[:5]:
        print(f"    {k:30} {v/1024:8.1f} KB/s")
else:
    print("  ⚠️ No results")
PYEOF

    echo ""
    echo "  💾 Full results: $RESULTS"
}

# ═══ Main ═══
case "${1:-all}" in
    ports)     tactic_ports ;;
    whitelist) tactic_whitelist ;;
    http3)     tactic_http3 ;;
    dns)       tactic_dns ;;
    ipv6)      tactic_ipv6 ;;
    warp)      tactic_warp ;;
    all|*)     cmd_all ;;
esac
