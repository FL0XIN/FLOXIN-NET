#!/usr/bin/env bash
# PANIC — طوارئ: يوقف كل حاجة ويرجّع النت
echo "═══════════════════════════════════════"
echo "  🆘 PANIC MODE"
echo "═══════════════════════════════════════"
echo ""

echo "[1/4] إيقاف DNS..."
pkill -9 -f "floxin_dns.py" 2>/dev/null
echo "  ✓"

echo "[2/4] إيقاف المحاكي..."
pkill -9 -f "throttle_proxy.py" 2>/dev/null
echo "  ✓"

echo "[3/4] مسح proxies..."
unset http_proxy https_proxy
echo "  ✓"

echo "[4/4] اختبار الاتصال..."
sleep 2
R=$(timeout 5 curl -s -o /dev/null -w "%{http_code}" --max-time 4 "https://1.1.1.1" 2>/dev/null)
if echo "$R" | grep -qE "200|301|302|400|403"; then
    echo "  ✓ النت شغال"
else
    echo "  ⚠ النت لسه واقف — اقفل VPN يدوياً من تليفونك"
    echo ""
    echo "  خطوات:"
    echo "    1. افتح Psiphon / WARP"
    echo "    2. اضغط Stop"
    echo "    3. استنى 10 ثواني"
    echo "    4. لو لسه واقف: Airplane Mode ON/OFF"
fi

echo ""
echo "═══════════════════════════════════════"
echo "  ✅ اتعمل"
echo "═══════════════════════════════════════"
