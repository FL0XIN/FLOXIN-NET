#!/usr/bin/env bash
set -u
FLOXIN_HOME="${FLOXIN_HOME:-$HOME/.floxin}"
API_DIR="$FLOXIN_HOME/api"
PID_FILE="$FLOXIN_HOME/api.pid"
LOG_FILE="$FLOXIN_HOME/api.log"

api_pid() {
    if [ -f "$PID_FILE" ]; then
        local pid; pid=$(cat "$PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then echo "$pid"; return 0; fi
        rm -f "$PID_FILE"
    fi
    return 1
}

cmd_start() {
    local pid
    if pid=$(api_pid); then echo "FLOXIN API already running — PID: $pid"; return 0; fi
    command -v python3 >/dev/null 2>&1 || { echo "python3 is required"; return 1; }
    python3 -c 'import fastapi, uvicorn' >/dev/null 2>&1 || {
        echo "FastAPI/Uvicorn missing. Run: FLOXIN doctor or install.sh"; return 1;
    }
    [ -f "$API_DIR/api/server.py" ] || { echo "API files missing: $API_DIR/api"; return 1; }
    mkdir -p "$FLOXIN_HOME"
    (cd "$FLOXIN_HOME" && FLOXIN_HOME="$FLOXIN_HOME" PYTHONPATH="$FLOXIN_HOME" nohup python3 -m uvicorn api.server:app --host 127.0.0.1 --port "${FLOXIN_API_PORT:-8080}" >>"$LOG_FILE" 2>&1 & echo $! > "$PID_FILE")
    sleep 1
    if pid=$(api_pid); then echo "FLOXIN API started — PID: $pid — http://127.0.0.1:${FLOXIN_API_PORT:-8080}"; else echo "FLOXIN API failed to start"; tail -20 "$LOG_FILE" 2>/dev/null; return 1; fi
}

cmd_stop() {
    local pid
    if pid=$(api_pid); then kill "$pid" 2>/dev/null || true; sleep 1; kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true; rm -f "$PID_FILE"; echo "FLOXIN API stopped"; else echo "FLOXIN API is not running"; fi
}

cmd_status() { if pid=$(api_pid); then echo "FLOXIN API running — PID: $pid — http://127.0.0.1:${FLOXIN_API_PORT:-8080}"; else echo "FLOXIN API stopped"; fi; }
cmd_log() { [ -f "$LOG_FILE" ] && tail -f "$LOG_FILE" || echo "No API log yet: $LOG_FILE"; }

case "${1:-status}" in
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_stop; cmd_start ;;
  status) cmd_status ;;
  log) cmd_log ;;
  *) echo "Usage: FLOXIN_API {start|stop|restart|status|log}"; exit 2 ;;
esac
