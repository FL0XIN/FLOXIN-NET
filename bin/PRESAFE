#!/usr/bin/env bash
# PRESAFE — works offline, prepares everything for throttle

echo "═══════════════════════════════════════"
echo "  PRESAFE — preparing for Throttle"
echo "═══════════════════════════════════════"
echo ""

# ═══ 1) Start local DNS ═══
echo "[1/5] Starting local DNS..."
if pgrep -f "floxin_dns.py" > /dev/null 2>&1; then
    echo "  ✓ already running"
else
    cd ~/dnsmasq && nohup python3 floxin_dns.py > dns.log 2>&1 &
    sleep 2
    echo "  ✓ started"
fi

# ═══ 2) Download full blocklist ═══
echo "[2/5] Checking blocklist..."
if [ -f "$HOME/dnsmasq/blocklist.txt" ]; then
    LINES=$(wc -l < "$HOME/dnsmasq/blocklist.txt")
    echo "  ✓ $LINES domains blocked (saved locally)"
else
    echo "  ⚠️ blocklist not found — Run: DNSMGR update (requires internet)"
fi

# ═══ 3) Download extra lists (if online) ═══
echo "[3/5] Downloading extra lists..."
cd ~/dnsmasq
for url in \
    "https://raw.githubusercontent.com/AdguardTeam/cname-trackers/master/data/combined_disguised_trackers_justdomains.txt|extra_trackers.txt" \
    "https://raw.githubusercontent.com/AdguardTeam/cname-trackers/master/data/combined_disguised_ads_justdomains.txt|extra_ads.txt"
do
    IFS='|' read -r u f <<< "$url"
    if [ ! -f "$f" ]; then
        curl -sS -L --max-time 20 -o "$f" "$u" 2>/dev/null && \
            echo "  ✓ $f ($(wc -l < $f) lines)" || \
            echo "  ⚠️ failed $f (will be retried next time)"
    else
        echo "  ✓ $f exists"
    fi
done

# ═══ 4) Test current speed ═══
echo "[4/5] Testing speed..."
SPEED=$(curl -o /dev/null -s -w "%{speed_download}" --max-time 10 "https://speed.cloudflare.com/__down?bytes=200000" 2>/dev/null)
if [ -z "$SPEED" ] || [ "$SPEED" = "0" ]; then
    echo "  ⚠️ No connection"
    STATUS="offline"
elif python3 -c "exit(0 if $SPEED < 50000 else 1)" 2>/dev/null; then
    echo "  🔴 Throttled ($(python3 -c "print(f'{$SPEED/1024:.0f} KB/s')"))"
    STATUS="throttled"
else
    echo "  🟢 normal speed ($(python3 -c "print(f'{$SPEED/1024:.0f} KB/s')"))"
    STATUS="normal"
fi

# ═══ 5) Recommendations ═══
echo "[5/5] Recommendations..."
echo ""
case "$STATUS" in
    offline)
        echo "  📱 No internet"
        echo "  → Local DNS running, blocklist saved"
        echo "  → When internet returns, run: PRESAFE"
        ;;
    throttled)
        echo "  🔴 Throttle!"
        echo ""
        echo "  Solutions ordered by preference:"
        echo "  1. Cloudflare WARP (1.1.1.1 from Play Store)"
        echo "  2. Run NETPROBE to compare: NETPROBE all"
        echo "  3. Run DNSPICK to choose the fastest DNS: DNSPICK auto"
        ;;
    normal)
        echo "  🟢 Everything is fine"
        echo "  → Enjoy the normal speed"
        ;;
esac

echo ""
echo "═══════════════════════════════════════"
echo "  💾 Everything saved locally"
echo "═══════════════════════════════════════"
echo ""
echo "  Scripts: ~/bin/"
echo "  DNS data:  ~/dnsmasq/"
echo "  Tools:  ~/net_tools/"
