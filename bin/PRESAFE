#!/usr/bin/env bash
# PRESAFE — يشتغل بدون نت، يحضّر كل حاجة للـ throttle

echo "═══════════════════════════════════════"
echo "  PRESAFE — تحضير للـ Throttle"
echo "═══════════════════════════════════════"
echo ""

# ═══ 1) تشغيل DNS المحلي ═══
echo "[1/5] تشغيل DNS المحلي..."
if pgrep -f "floxin_dns.py" > /dev/null 2>&1; then
    echo "  ✓ شغال بالفعل"
else
    cd ~/dnsmasq && nohup python3 floxin_dns.py > dns.log 2>&1 &
    sleep 2
    echo "  ✓ تم التشغيل"
fi

# ═══ 2) تحميل blocklist كامل ═══
echo "[2/5] فحص blocklist..."
if [ -f "$HOME/dnsmasq/blocklist.txt" ]; then
    LINES=$(wc -l < "$HOME/dnsmasq/blocklist.txt")
    echo "  ✓ $LINES دومين محجوب (محفوظ محلياً)"
else
    echo "  ⚠️ blocklist مش موجود — شغّل: DNSMGR update (محتاج نت)"
fi

# ═══ 3) تحميل قوائم إضافية (لو فيه نت) ═══
echo "[3/5] تحميل قوائم إضافية..."
cd ~/dnsmasq
for url in \
    "https://raw.githubusercontent.com/AdguardTeam/cname-trackers/master/data/combined_disguised_trackers_justdomains.txt|extra_trackers.txt" \
    "https://raw.githubusercontent.com/AdguardTeam/cname-trackers/master/data/combined_disguised_ads_justdomains.txt|extra_ads.txt"
do
    IFS='|' read -r u f <<< "$url"
    if [ ! -f "$f" ]; then
        curl -sS -L --max-time 20 -o "$f" "$u" 2>/dev/null && \
            echo "  ✓ $f ($(wc -l < $f) سطر)" || \
            echo "  ⚠️ فشل $f (هيتبعت المرة الجاية)"
    else
        echo "  ✓ $f موجود"
    fi
done

# ═══ 4) اختبار السرعة الحالية ═══
echo "[4/5] اختبار السرعة..."
SPEED=$(curl -o /dev/null -s -w "%{speed_download}" --max-time 10 "https://speed.cloudflare.com/__down?bytes=200000" 2>/dev/null)
if [ -z "$SPEED" ] || [ "$SPEED" = "0" ]; then
    echo "  ⚠️ مفيش اتصال"
    STATUS="offline"
elif python3 -c "exit(0 if $SPEED < 50000 else 1)" 2>/dev/null; then
    echo "  🔴 Throttled ($(python3 -c "print(f'{$SPEED/1024:.0f} KB/s')"))"
    STATUS="throttled"
else
    echo "  🟢 سرعة طبيعية ($(python3 -c "print(f'{$SPEED/1024:.0f} KB/s')"))"
    STATUS="normal"
fi

# ═══ 5) توصيات ═══
echo "[5/5] التوصيات..."
echo ""
case "$STATUS" in
    offline)
        echo "  📱 مفيش نت"
        echo "  → DNS المحلي شغال، blocklist محفوظ"
        echo "  → لما النت يرجع، شغّل: PRESAFE"
        ;;
    throttled)
        echo "  🔴 Throttle!"
        echo ""
        echo "  الحلول مرتبة بالأفضلية:"
        echo "  1. Cloudflare WARP (1.1.1.1 من Play Store)"
        echo "  2. شغّل NETPROBE للمقارنة: NETPROBE all"
        echo "  3. شغّل DNSPICK لاختيار أسرع DNS: DNSPICK auto"
        ;;
    normal)
        echo "  🟢 كل حاجة تمام"
        echo "  → استفد بالسرعة العادية"
        ;;
esac

echo ""
echo "═══════════════════════════════════════"
echo "  💾 كل حاجة محفوظة محلياً"
echo "═══════════════════════════════════════"
echo ""
echo "  السكربتات: ~/bin/"
echo "  DNS data:  ~/dnsmasq/"
echo "  الأدوات:  ~/net_tools/"
