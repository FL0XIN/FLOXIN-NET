#!/usr/bin/env bash
# CHECK — فحص سريع

G="\033[32m"; R="\033[31m"; Y="\033[33m"; N="\033[0m"

echo "═══════════════════════════════════════"
echo "  🔍 فحص النظام"
echo "═══════════════════════════════════════"
echo ""

# DNS Server
if pgrep -f "floxin_dns.py" > /dev/null; then
    PID=$(pgrep -f "floxin_dns.py" | head -1)
    echo -e "  ${G}✓${N} DNS Server (PID: $PID)"
    DNS_OK=1
else
    echo -e "  ${R}✗${N} DNS Server — متوقف"
    DNS_OK=0
fi

# اختبار query
if [ "$DNS_OK" = "1" ]; then
    R=$(timeout 3 dig @127.0.0.1 -p 5353 google.com +short +timeout=2 2>/dev/null | grep -v ";" | head -1)
    if [ -n "$R" ] && [ "$R" != "0.0.0.0" ]; then
        echo -e "  ${G}✓${N} DNS يرد — google → $R"
    else
        echo -e "  ${R}✗${N} DNS لا يرد — شغّل: DNSF restart"
    fi
fi

# Blocking
if [ "$DNS_OK" = "1" ]; then
    B=$(timeout 3 dig @127.0.0.1 -p 5353 doubleclick.net +short +timeout=2 2>/dev/null | grep -v ";" | head -1)
    if [ "$B" = "0.0.0.0" ]; then
        echo -e "  ${G}✓${N} الحجب شغال"
    else
        echo -e "  ${Y}⚠${N} الحجب مش شغال"
    fi
fi

# Blocklist
if [ -f "$HOME/dnsmasq/blocklist.txt" ]; then
    CNT=$(wc -l < "$HOME/dnsmasq/blocklist.txt")
    echo -e "  ${G}✓${N} Blocklist — $CNT دومين"
fi

# السرعة
echo ""
S=$(timeout 8 curl -o /dev/null -s -w "%{speed_download}" --max-time 7 "https://speed.cloudflare.com/__down?bytes=200000" 2>/dev/null)
if [ -z "$S" ] || [ "$S" = "0" ]; then
    echo -e "  ${R}✗${N} مفيش اتصال بالنت"
elif python3 -c "exit(0 if $S < 100000 else 1)" 2>/dev/null; then
    KB=$(python3 -c "print(f'{$S/1024:.0f}')")
    echo -e "  ${Y}⚠${N} Throttled — ${KB} KB/s"
else
    KB=$(python3 -c "print(f'{$S/1024:.0f}')")
    echo -e "  ${G}✓${N} السرعة طبيعية — ${KB} KB/s"
fi

echo ""
echo "═══════════════════════════════════════"

if [ "$DNS_OK" = "1" ]; then
    echo -e "  ${G}✅ النظام شغال${N}"
else
    echo -e "  ${R}❌ شغّل: DNSF restart${N}"
fi
echo "═══════════════════════════════════════"
