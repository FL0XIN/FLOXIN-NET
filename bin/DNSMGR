#!/usr/bin/env bash
# DNSMGR — FLOXIN DNS Manager

DNS_DIR="$HOME/dnsmasq"
SCRIPT="$DNS_DIR/floxin_dns.py"
LOG="$DNS_DIR/dns.log"
PID_FILE="$DNS_DIR/.dns.pid"
PORT="5353"

_is_running() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$PID" ] && ps -p $PID > /dev/null 2>&1; then
            return 0
        fi
    fi
    pgrep -f "floxin_dns.py" > /dev/null 2>&1
}

_kill_all() {
    pkill -9 -f "floxin_dns.py" 2>/dev/null
    sleep 1
    rm -f "$PID_FILE"
}

cmd_start() {
    echo "═══ Running DNS ═══"
    if [ ! -f "$SCRIPT" ]; then
        echo "✗ $SCRIPT not found"; exit 1
    fi
    if _is_running; then
        echo "⚠️ already running"; cmd_status; return
    fi
    _kill_all
    cd "$DNS_DIR"
    nohup python3 "$SCRIPT" > "$LOG" 2>&1 &
    PID=$!
    echo $PID > "$PID_FILE"
    disown
    sleep 3
    if _is_running; then
        echo "✅ running — PID: $PID"
        echo "🌐 127.0.0.1:$PORT"
        tail -8 "$LOG"
    else
        echo "✗ failed"; tail -20 "$LOG"
    fi
}

cmd_stop() { echo "⏹ Stopping"; _kill_all; echo "✓"; }

cmd_restart() { cmd_stop; sleep 1; cmd_start; }

cmd_status() {
    if _is_running; then
        PID=$(cat "$PID_FILE" 2>/dev/null)
        [ -z "$PID" ] && PID=$(pgrep -f "floxin_dns.py" | head -1)
        echo "✅ running — PID: $PID"
        ps -p $PID -o %cpu,%mem,etime 2>/dev/null
        echo ""
        tail -5 "$LOG"
    else
        echo "❌ stopped"
    fi
}

cmd_log() { tail -f "$LOG"; }

cmd_test() {
    echo "═══ Test ═══"
    if ! _is_running; then echo "⚠️ Run: DNSMGR start"; return; fi
    echo "1) google:"; nslookup -type=A google.com 127.0.0.1 2>&1 | tail -4
    echo ""
    echo "2) doubleclick (blocked):"; nslookup -type=A doubleclick.net 127.0.0.1 2>&1 | tail -4
}

cmd_vpn() {
    echo "═══ VPN status ═══"
    echo ""

    # Detect real VPN (tun interface)
    local VPN_IFACE=$(ifconfig 2>/dev/null | grep -E "^(tun|ppp|wg)[0-9]" | head -1 | cut -d: -f1)
    if [ -n "$VPN_IFACE" ]; then
        echo "  ⚠️ VPN active ($VPN_IFACE)"
        echo "     Note: our DNS is not being used"
        WARP=1
    else
        echo "  ✓ VPN down"
        WARP=""
    fi
    echo ""

    # Is our DNS running?
    if pgrep -f "floxin_dns.py" > /dev/null; then
        echo "  ✓ local DNS is running"
    else
        echo "  ✗ local DNS stopped"
    fi
    echo ""

    # Warning
    if [ -n "$WARP" ]; then
        echo "═══════════════════════════════════════"
        echo "  ⚠️ Warning: possible conflict"
        echo "═══════════════════════════════════════"
        echo "  The VPN takes all traffic,"
        echo "  so local DNS isn't used."
        echo ""
        echo "  Solution:"
        echo "  - For DNS only: turn off the VPN"
        echo "  - For VPN only: DNSMGR stop then start VPN"
        echo "  - For both: no solution on Termux"
    else
        echo "═══════════════════════════════════════"
        echo "  ✓ No conflict"
        echo "═══════════════════════════════════════"
    fi
}

cmd_mode() {
    local mode="${1:-show}"
    case "$mode" in
        dns)
            echo "═══ DNS-only mode ═══"
            echo "  (No VPN + DNS running)"
            echo ""
            # Turn off any open VPN
            echo "  ⚠️  Manually turn off WARP and Psiphon from your phone"
            echo ""
            # Ensure DNS is running
            if ! pgrep -f "floxin_dns.py" > /dev/null; then
                echo "  → Starting DNS..."
                cd "$HOME/dnsmasq" && nohup python3 floxin_dns.py > dns.log 2>&1 &
                disown
                sleep 2
            fi
            echo "  ✓ DNS running on 127.0.0.1:5353"
            echo "  ✓ blocking is active"
            ;;
        vpn)
            echo "═══ VPN-only mode ═══"
            echo "  (VPN + DNS disabled)"
            echo ""
            # Turn off DNS
            if pgrep -f "floxin_dns.py" > /dev/null; then
                echo "  → Stopping DNS..."
                pkill -9 -f "floxin_dns.py"
                sleep 1
            fi
            echo "  ✓ DNS stopped"
            echo ""
            echo "  → Open WARP (1.1.1.1) on your phone"
            echo "  → If it fails: open Psiphon Pro"
            ;;
        show|*)
            cmd_vpn
            ;;
    esac
}

cmd_help() {
    cat << EOF
DNSMGR — FLOXIN DNS Manager

  DNSMGR start         → Start DNS
  DNSMGR stop          → Stop DNS
  DNSMGR restart       → Restart
  DNSMGR status        → Status
  DNSMGR log           → Log
  DNSMGR test          → Full test

  DNSMGR vpn           → Check VPN conflict
  DNSMGR mode dns      → DNS-only mode (disables VPN)
  DNSMGR mode vpn      → VPN-only mode (disables DNS)
  DNSMGR mode show     → Show current mode

  DNSMGR help          → Help
EOF
}

CMD="${1:-help}"
case "$CMD" in
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    status) cmd_status ;;
    log) cmd_log ;;
    test) cmd_test ;;
    vpn) cmd_vpn ;;
    mode) cmd_mode "$2" ;;
    help|*) cmd_help ;;
esac
