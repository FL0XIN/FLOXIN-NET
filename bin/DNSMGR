#!/usr/bin/env bash
# DNSMGR — FLOXIN DNS Manager

DNS_DIR="$HOME/dnsmasq"
SCRIPT="$DNS_DIR/floxin_dns.py"
LOG="$DNS_DIR/dns.log"
PID_FILE="$DNS_DIR/.dns.pid"
PORT="5353"

_is_running() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$PID" ] && ps -p $PID > /dev/null 2>&1; then
            return 0
        fi
    fi
    pgrep -f "floxin_dns.py" > /dev/null 2>&1
}

_kill_all() {
    pkill -9 -f "floxin_dns.py" 2>/dev/null
    sleep 1
    rm -f "$PID_FILE"
}

cmd_start() {
    echo "═══ تشغيل DNS ═══"
    if [ ! -f "$SCRIPT" ]; then
        echo "✗ $SCRIPT مش موجود"; exit 1
    fi
    if _is_running; then
        echo "⚠️ شغال بالفعل"; cmd_status; return
    fi
    _kill_all
    cd "$DNS_DIR"
    nohup python3 "$SCRIPT" > "$LOG" 2>&1 &
    PID=$!
    echo $PID > "$PID_FILE"
    disown
    sleep 3
    if _is_running; then
        echo "✅ يعمل — PID: $PID"
        echo "🌐 127.0.0.1:$PORT"
        tail -8 "$LOG"
    else
        echo "✗ فشل"; tail -20 "$LOG"
    fi
}

cmd_stop() { echo "⏹ إيقاف"; _kill_all; echo "✓"; }

cmd_restart() { cmd_stop; sleep 1; cmd_start; }

cmd_status() {
    if _is_running; then
        PID=$(cat "$PID_FILE" 2>/dev/null)
        [ -z "$PID" ] && PID=$(pgrep -f "floxin_dns.py" | head -1)
        echo "✅ يعمل — PID: $PID"
        ps -p $PID -o %cpu,%mem,etime 2>/dev/null
        echo ""
        tail -5 "$LOG"
    else
        echo "❌ متوقف"
    fi
}

cmd_log() { tail -f "$LOG"; }

cmd_test() {
    echo "═══ اختبار ═══"
    if ! _is_running; then echo "⚠️ شغّل: DNSMGR start"; return; fi
    echo "1) google:"; nslookup -type=A google.com 127.0.0.1 2>&1 | tail -4
    echo ""
    echo "2) doubleclick (محجوب):"; nslookup -type=A doubleclick.net 127.0.0.1 2>&1 | tail -4
}

cmd_vpn() {
    echo "═══ حالة VPN ═══"
    echo ""

    # كشف VPN الحقيقي (tun interface)
    local VPN_IFACE=$(ifconfig 2>/dev/null | grep -E "^(tun|ppp|wg)[0-9]" | head -1 | cut -d: -f1)
    if [ -n "$VPN_IFACE" ]; then
        echo "  ⚠️ VPN شغال ($VPN_IFACE)"
        echo "     ملاحظة: DNS بتاعنا مش بيتستخدم"
        WARP=1
    else
        echo "  ✓ VPN مقفول"
        WARP=""
    fi
    echo ""

    # هل DNS بتاعنا شغال؟
    if pgrep -f "floxin_dns.py" > /dev/null; then
        echo "  ✓ DNS المحلي شغال"
    else
        echo "  ✗ DNS المحلي متوقف"
    fi
    echo ""

    # التحذير
    if [ -n "$WARP" ]; then
        echo "═══════════════════════════════════════"
        echo "  ⚠️ تحذير: تعارض محتمل"
        echo "═══════════════════════════════════════"
        echo "  الـ VPN بياخد الترافيك كله،"
        echo "  فالـ DNS المحلي مش بيتخدم."
        echo ""
        echo "  الحل:"
        echo "  - للـ DNS فقط: اقفل الـ VPN"
        echo "  - للـ VPN فقط: DNSMGR stop ثم افتح VPN"
        echo "  - للاتنين: مفيش حل على Termux"
    else
        echo "═══════════════════════════════════════"
        echo "  ✓ مفيش تعارض"
        echo "═══════════════════════════════════════"
    fi
}

cmd_mode() {
    local mode="${1:-show}"
    case "$mode" in
        dns)
            echo "═══ وضع DNS فقط ═══"
            echo "  (لا VPN + DNS شغال)"
            echo ""
            # اقفل أي VPN مفتوح
            echo "  ⚠️  اقفل WARP و Psiphon يدوياً من تليفونك"
            echo ""
            # تأكد DNS شغال
            if ! pgrep -f "floxin_dns.py" > /dev/null; then
                echo "  → تشغيل DNS..."
                cd "$HOME/dnsmasq" && nohup python3 floxin_dns.py > dns.log 2>&1 &
                disown
                sleep 2
            fi
            echo "  ✓ DNS شغال على 127.0.0.1:5353"
            echo "  ✓ الحجب فعّال"
            ;;
        vpn)
            echo "═══ وضع VPN فقط ═══"
            echo "  (VPN + DNS مقفول)"
            echo ""
            # اقفل DNS
            if pgrep -f "floxin_dns.py" > /dev/null; then
                echo "  → إيقاف DNS..."
                pkill -9 -f "floxin_dns.py"
                sleep 1
            fi
            echo "  ✓ DNS متوقف"
            echo ""
            echo "  → افتح WARP (1.1.1.1) من تليفونك"
            echo "  → لو فشل: افتح Psiphon Pro"
            ;;
        show|*)
            cmd_vpn
            ;;
    esac
}

cmd_help() {
    cat << EOF
DNSMGR — FLOXIN DNS Manager

  DNSMGR start         → تشغيل DNS
  DNSMGR stop          → إيقاف DNS
  DNSMGR restart       → إعادة تشغيل
  DNSMGR status        → الحالة
  DNSMGR log           → السجل
  DNSMGR test          → اختبار شامل

  DNSMGR vpn           → فحص تعارض VPN
  DNSMGR mode dns      → وضع DNS فقط (يقفل VPN)
  DNSMGR mode vpn      → وضع VPN فقط (يقفل DNS)
  DNSMGR mode show     → عرض الوضع الحالي

  DNSMGR help          → المساعدة
EOF
}

CMD="${1:-help}"
case "$CMD" in
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    status) cmd_status ;;
    log) cmd_log ;;
    test) cmd_test ;;
    vpn) cmd_vpn ;;
    mode) cmd_mode "$2" ;;
    help|*) cmd_help ;;
esac
